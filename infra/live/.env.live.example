# Live server settings. Copy to infra/live/.env.live (git-ignored).

# Hostname creators publish to and viewers' players fetch from (DNS A record → this box).
LIVE_DOMAIN=live.streamzw.example

# The main API, reached over the internet (MediaMTX auth hook + worker reports).
LIVE_API_BASE=https://api.streamzw.example
# Same values as the main stack's infra/.env.production:
LIVE_INGEST_SECRET=
LIVE_SIGNING_SECRET=

# libx264 (CPU) or h264_nvenc (NVIDIA GPU; uncomment the deploy block in the compose file).
LIVE_ENCODER=libx264

# Replays upload to the main stack's MinIO through its public media host.
MINIO_ENDPOINT=https://media.streamzw.example
MINIO_ACCESS_KEY=streamzw
MINIO_SECRET_KEY=
MINIO_BUCKET_VIDEOS=streamzw-videos
MINIO_BUCKET_THUMBS=streamzw-thumbs
MINIO_REGION=us-east-1
