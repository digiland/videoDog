# StreamZW production settings. Copy to infra/.env.production (git-ignored), fill in,
# then follow docs/DEPLOY.md. Generate secrets with the commands shown.

# ── Site ───────────────────────────────────────────────────────────────────
# Bare domain. DNS A records for DOMAIN, api.DOMAIN and media.DOMAIN → this server.
DOMAIN=streamzw.example

# ── Data stores ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=          # openssl rand -hex 24
MINIO_ROOT_USER=streamzw
MINIO_ROOT_PASSWORD=        # openssl rand -hex 24

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=          # openssl rand -hex 32
JWT_REFRESH_SECRET=         # openssl rand -hex 32 (different from the access secret)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PLAYBACK_SIGNING_SECRET=    # openssl rand -hex 32
KYC_ENCRYPTION_KEY=         # openssl rand -base64 32 — back this up: lost key = unreadable IDs
# OTP rate limiting (1/min, 5/hour per phone) is on unless OTP_RATE_LIMIT=off. Leave it on.

# WhatsApp Business (primary OTP channel)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# SMS fallback
SMS_PROVIDER=bulkgate
SMS_API_KEY=

# ── Payments ───────────────────────────────────────────────────────────────
# EcoCash: endpoint paths are placeholders until the merchant API spec arrives (docs/REVIEW.md).
ECOCASH_API_BASE=https://api.ecocash.co.zw
ECOCASH_USD_MERCHANT_CODE=
ECOCASH_USD_API_KEY=
ECOCASH_ZWG_MERCHANT_CODE=
ECOCASH_ZWG_API_KEY=
ECOCASH_WEBHOOK_SECRET=     # openssl rand -hex 32; also set in the EcoCash merchant portal
# Paystack (cards, ZAR/USD). Webhook URL: https://api.DOMAIN/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── FX ─────────────────────────────────────────────────────────────────────
OPENEXCHANGERATES_APP_ID=
RBZ_FEED_URL=https://www.rbz.co.zw/index.php/research/markets/exchange-rates

# ── Live streaming (infra/live, a separate server) ─────────────────────────
LIVE_DOMAIN=live.streamzw.example   # creators publish here; also the HLS origin
# Players fetch live HLS here. Point it at a BunnyCDN pull zone (origin https://LIVE_DOMAIN)
# for real audiences: a single origin can't serve thousands of 4K viewers.
LIVE_PUBLIC_BASE=https://live.streamzw.example
LIVE_INGEST_SECRET=         # openssl rand -hex 32; same value on the live server
LIVE_SIGNING_SECRET=        # openssl rand -hex 32; same value on the live server

# ── CDN (optional) ─────────────────────────────────────────────────────────
# With both set, playback goes through BunnyCDN (pull zone origin: https://media.DOMAIN).
# Without them the API serves token-gated playlists and segments come from media.DOMAIN.
BUNNYCDN_PULLZONE=
BUNNYCDN_SIGNING_KEY=
PLAYBACK_TTL_SECONDS=21600

# Never enable these in production (the API ignores them when NODE_ENV=production).
DEV_LOG_OTP=false
DEV_SIMULATE_PAYMENTS=false
