# Rendered by the nginx image's envsubst at start (${DOMAIN} only).
# TLS certificate: one Let's Encrypt cert covering all three hosts (infra/scripts/init-letsencrypt.sh).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# ── HTTP: ACME challenges, everything else to HTTPS ─────────────────────────
server {
  listen 80;
  server_name ${DOMAIN} api.${DOMAIN} media.${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml application/vnd.apple.mpegurl;

# ── Web (Next.js) ───────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /_next/static/ {
    proxy_pass http://web:3030;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location / {
    proxy_pass http://web:3030;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# ── API (NestJS) ────────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name api.${DOMAIN};

  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 10m;   # JSON + caption files; videos go straight to media.

  location / {
    proxy_pass http://api:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
}

# ── Media (MinIO): presigned uploads and downloads ──────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name media.${DOMAIN};

  add_header Strict-Transport-Security "max-age=31536000" always;
  # Resumable uploads send 8 MiB parts; single-PUT thumbnails/captions are small.
  client_max_body_size 64m;
  proxy_request_buffering off;
  proxy_buffering off;

  location / {
    proxy_pass http://minio:9000;
    proxy_http_version 1.1;
    # SigV4 signs the Host header: MinIO must see the public host the URL was signed for.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 300;
    proxy_read_timeout 300;
    chunked_transfer_encoding off;
  }
}
