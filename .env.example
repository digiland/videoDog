# ──────────── apps/api ────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://streamzw:streamzw@127.0.0.1:5433/streamzw
REDIS_URL=redis://127.0.0.1:6379

# JWT (M2) — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=dev-refresh-secret-replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage (M3) — points at Adrian's shared RustFS (S3-compatible) on :9000.
# Var names stay MINIO_* per CLAUDE.md §11; underlying service is RustFS in dev.
# Buckets `streamzw-videos` and `streamzw-thumbs` must exist in RustFS — create via
# infra/scripts/init-buckets.sh after RustFS is running.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin1234
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin1234
MINIO_BUCKET_VIDEOS=streamzw-videos
MINIO_BUCKET_THUMBS=streamzw-thumbs
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL=3600

# CDN (M4)
BUNNYCDN_PULLZONE=
BUNNYCDN_SIGNING_KEY=

# WhatsApp Business (M2)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# SMS fallback (M2)
SMS_PROVIDER=bulkgate
SMS_API_KEY=

# EcoCash (M6)
ECOCASH_USD_MERCHANT_CODE=
ECOCASH_USD_API_KEY=
ECOCASH_ZWG_MERCHANT_CODE=
ECOCASH_ZWG_API_KEY=
ECOCASH_WEBHOOK_SECRET=

# ZIPIT (M6)
ZIPIT_MERCHANT_ID=
ZIPIT_API_KEY=
ZIPIT_WEBHOOK_SECRET=

# Paystack (M6)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# FX (M7)
OPENEXCHANGERATES_APP_ID=
RBZ_FEED_URL=https://www.rbz.co.zw/index.php/research/markets/exchange-rates

# ──────────── apps/web ────────────
NEXT_PUBLIC_API_BASE=http://localhost:3001
WEB_PORT=3030
WEB_HOST_PORT=3040
NEXT_PUBLIC_CDN_BASE=
